DATABASE_URL=postgres://postgres:postgres@localhost:5432/vjcrawford
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
PORT=4000
# Comma-separated list of allowed frontend URLs
CORS_ORIGIN=http://localhost:5173

# Deployed hosts only: load the demo firm on boot. Requires DEMO_PASSWORD
# (10+ characters). Set back to false after the first successful run.
SEED_ON_BOOT=false
DEMO_PASSWORD=

# Allow POST /auth/register to create new firms. Leave false in production;
# set true only briefly if a fresh database needs its first firm.
ALLOW_REGISTRATION=false
